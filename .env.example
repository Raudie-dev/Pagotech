# ====================================================================
# PAGOTECH - PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN
# Copiar este archivo como ".env" en el servidor y completar valores.
# ====================================================================

ENVIRONMENT=PROD
DEBUG=False

# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-al-menos-50-caracteres

# Dominios permitidos separados por coma (sin espacios ni https://)
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Orígenes confiables para CSRF separados por coma (con https://)
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com
SITE_URL=https://tudominio.com

# Base de datos MySQL (usada cuando ENVIRONMENT=PROD)
DB_NAME=pagotech_db
DB_USER=pagotech_user
DB_PASSWORD=cambia-esta-contrasena-db
DB_HOST=127.0.0.1
DB_PORT=3306

# Pasarela PayZen
PAYZEN_SHOP_ID=tu-shop-id
PAYZEN_REST_PASS=tu-rest-password
PAYZEN_URL=https://api.payzen.lat/api-payment/V4/Charge/CreatePaymentOrder
PAYZEN_CHECK_URL=https://api.payzen.lat/api-payment/V4/Order/Get

# Correo SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones@tudominio.com
EMAIL_HOST_PASSWORD=tu-app-password-smtp
EMAIL_RECEPTORES=admin@tudominio.com

# Seguridad HTTPS (en PROD por defecto True)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# WhatsApp soporte
WHATSAPP_NUMBER=5491100000000
WHATSAPP_MESSAGE=Hola, necesito ayuda con Pago Tech.
